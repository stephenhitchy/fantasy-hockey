{
  "name": "fantasy-hockey",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:all": "npm run build && npm --prefix functions run build",
    "deploy:production": "npm run build:all && firebase deploy --only firestore:rules,firestore:indexes,functions,hosting:app",
    "deploy:season-ready": "npm run build:all && firebase deploy --only firestore:rules,firestore:indexes,functions,hosting:app",
    "repair:functions": "npm --prefix functions run repair:dependencies",
    "validate:team-logos": "node scripts/validate-team-logo-urls.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "firebase": "^12.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
