      "requiredTokens": [
        "requireServerFirestoreDocumentId",
        "FIRESTORE_SNAPSHOT_ID_OPTIONS",
        "FIRESTORE_LEAGUE_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/shared/core/projection/projection-asset-catalog.service.ts",
