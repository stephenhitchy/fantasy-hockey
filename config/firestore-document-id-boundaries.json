    {
      "file": "functions/src/private-season-authority.ts",
      "kind": "Private-season administrator and exact tester-league identifiers",
      "requiredTokens": [
        "requireFirestoreDocumentId"
      ]
    },
    {
      "file": "functions/src/private-season-health.ts",
      "kind": "Private-season engagement, weekly health, and exact tester-league identifiers",
      "requiredTokens": [
        "requireFirestoreDocumentId",
        "privateSeasonManagerHash"
      ]
    }
  ],
  "forbiddenDirectPathSources": [
    "event.params",
    "request.auth.uid",
    "request.data",
    "payload."
  ]
}
