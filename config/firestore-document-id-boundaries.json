        "resolveSafeFirestoreDocumentId",
        "FIRESTORE_LEAGUE_ID_OPTIONS",
        "FIRESTORE_DRAFT_PICK_ID_OPTIONS",
        "FIRESTORE_AUTH_USER_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/league-automation.ts",
      "kind": "Scoring queue, historical replay, and schedule identifiers",
      "requiredTokens": [
        "requireServerFirestoreDocumentId",
        "FIRESTORE_TASK_ID_OPTIONS",
        "FIRESTORE_REQUEST_ID_OPTIONS",
        "FIRESTORE_ASSET_KEY_OPTIONS"
      ]
    },
    {
      "file": "functions/src/projection-authority.ts",
      "kind": "Projection queue request and manager identifiers",
      "requiredTokens": [
        "resolveSafeFirestoreDocumentId",
        "FIRESTORE_REQUEST_ID_OPTIONS",
        "FIRESTORE_AUTH_USER_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/shared/core/projection/projection-snapshot.service.ts",
