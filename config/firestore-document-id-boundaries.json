      "requiredTokens": [
        "requireServerFirestoreDocumentId",
        "FIRESTORE_CATALOG_ID_OPTIONS",
        "resolveSafeFirestoreDocumentId"
      ]
    },
    {
      "file": "functions/src/draft-authority.ts",
      "kind": "Draft order, invite, and persisted manager identifiers",
      "requiredTokens": [
        "resolveSafeFirestoreDocumentId",
        "FIRESTORE_INVITE_CODE_OPTIONS",
        "FIRESTORE_AUTH_USER_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/email-notifications.ts",
      "kind": "Profile and injury trigger parameters",
      "requiredTokens": [
        "resolveSafeFirestoreDocumentId",
        "FIRESTORE_PLAYER_ID_OPTIONS",
        "FIRESTORE_AUTH_USER_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/index.ts",
      "kind": "Callable authentication and feedback membership paths",
      "requiredTokens": [
        "resolveSafeFirestoreDocumentId",
        "FIRESTORE_AUTH_USER_ID_OPTIONS"
      ]
    },
    {
      "file": "functions/src/roster-authority.ts",
      "kind": "Roster, waiver, owner, slot, and asset callable inputs",
      "requiredTokens": [
        "requireFirestoreDocumentId",
        "normalizedSecureRosterActionRequest"
      ]
    },
    {
      "file": "functions/src/roster-moves.ts",
      "kind": "Add-drop and lineup callable path inputs",
      "requiredTokens": [
        "requireFirestoreDocumentId",
        "input.activeSlotId"
      ]
    },
    {
      "file": "functions/src/league-lifecycle-authority.ts",
      "kind": "League create, join, migration, invite, and owner inputs",
      "requiredTokens": [
        "requireFirestoreDocumentId",
        "createLeagueSecure",
        "joinLeagueSecure"
      ]
    },
    {
      "file": "functions/src/manager-profile-authority.ts",
      "kind": "Private and public profile owner identifiers",
      "requiredTokens": [
        "requireFirestoreDocumentId"
      ]
    },
    {
      "file": "functions/src/beta-operations.ts",
      "kind": "Feedback, evidence, known-issue, and rate-limit identifiers",
      "requiredTokens": [
        "requireFirestoreDocumentId"
      ]
    },
    {
      "file": "functions/src/app-check-canary-authority.ts",
