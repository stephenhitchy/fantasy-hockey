{
  "schemaVersion": 1,
  "release": "Security Batch S3F",
  "purpose": "Inventory every external or persisted identifier boundary that can become a Firestore path segment.",
  "policies": {
    "authUserId": "FIRESTORE_AUTH_USER_ID_OPTIONS",
    "leagueId": "FIRESTORE_LEAGUE_ID_OPTIONS",
    "requestId": "FIRESTORE_REQUEST_ID_OPTIONS",
    "taskId": "FIRESTORE_TASK_ID_OPTIONS",
    "draftPickId": "FIRESTORE_DRAFT_PICK_ID_OPTIONS",
    "rosterSlotId": "FIRESTORE_ROSTER_SLOT_ID_OPTIONS",
    "assetKey": "FIRESTORE_ASSET_KEY_OPTIONS",
    "snapshotId": "FIRESTORE_SNAPSHOT_ID_OPTIONS",
    "catalogId": "FIRESTORE_CATALOG_ID_OPTIONS",
    "inviteCode": "FIRESTORE_INVITE_CODE_OPTIONS",
    "playerId": "FIRESTORE_PLAYER_ID_OPTIONS",
    "feedbackId": "FIRESTORE_FEEDBACK_ID_OPTIONS",
    "fingerprintId": "FIRESTORE_FINGERPRINT_ID_OPTIONS"
  },
  "boundaries": [
    {
      "file": "functions/src/draft-automation.ts",
